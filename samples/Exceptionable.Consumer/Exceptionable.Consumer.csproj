<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Exceptionable>enable</Exceptionable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Exceptionable" Version="*-*" />
    <PackageReference Include="Exceptionable.Analyzers" Version="*-*" PrivateAssets="all" />
  </ItemGroup>
</Project>
